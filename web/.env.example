# 与 ../compose.yaml 的本机开发配置对应。不要加 NEXT_PUBLIC_ 前缀。
DATABASE_URL=postgresql://deep_research:local_development_only@127.0.0.1:55433/deep_research
REDIS_URL=redis://127.0.0.1:56379/0
APP_ORIGIN=http://localhost:3000
# 生成方式见 README；三个值填好后才启用 GitHub 登录。
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 非敏感的运行配置，P3 Worker 必须识别这个 profile。
RESEARCH_MODEL_PROFILE=deepseek-default-v1
RESEARCH_MODEL_NAME=deepseek-chat
RESEARCH_CODE_VERSION=local-p2
RESEARCH_PROMPT_VERSION=v1
RESEARCH_COMPRESSION_ENABLED=true
# queued + running 的每用户上限；同一幂等请求重放不占新额度。
MAX_ACTIVE_TASKS_PER_USER=3

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-pro

TAVILY_API_KEY=
MAX_SEARCH_ROUNDS=2
MAX_RESULTS_PER_QUERY=5
MAX_CONCURRENT_RESEARCHERS=2
# 生成研究简报供 Supervisor 阅读；每个有发现的任务增加一次模型调用。
ENABLE_RESEARCH_COMPRESSION=false

# Worker 可复用 web/.env.local 的连接地址；以下环境变量可以显式覆盖。
# DATABASE_URL=postgresql://deep_research:local_development_only@127.0.0.1:55433/deep_research
# REDIS_URL=redis://127.0.0.1:56379/0
WORKER_HEARTBEAT_SECONDS=10
WORKER_LEASE_SECONDS=60
WORKER_RECONCILE_AFTER_SECONDS=60
WORKER_STALE_QUEUE_SECONDS=300
